{
  "name": "newdich",
  "version": "2.0.0",
  "private": true,
  "description": "Newdich Technology \u2014 engineering, IoT, AI and training. Abuja & Okitipupa, Nigeria.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "serve": "npx --yes serve@14 out",
