# The contact endpoint (api/contact.ts). Set these on the host, never in the
# client bundle — a Resend key is a secret and there is no browser-safe
# publishable variant of it. Never give one of these a NEXT_PUBLIC_ prefix:
# that prefix is the instruction to inline the value into the bundle.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where enquiries land.
CONTACT_TO=newdichngr@gmail.com

# Optional. Must be a sender on a domain verified in the Resend dashboard.
# Until newdich.tech is verified, Resend's shared onboarding sender is used.
CONTACT_FROM=Newdich site <hello@newdich.tech>

# Optional, and worth setting. The origins allowed to post to the endpoint,
# comma-separated. With it set, a post carrying any other Origin is refused
# with a 403; left unset, the origin is not checked at all, because this file
# cannot know what hostname a given deployment answers on. Add the preview
# domain too if the form is tested there.
CONTACT_ORIGINS=https://newdich.tech,https://www.newdich.tech

# Required for the application/admin system. MySQL connection string.
# Example: mysql://user:password@localhost:3306/newdich
DATABASE_URL=mysql://user:password@localhost:3306/newdich

# Required. Email of the initial superadmin created on first migration.
SUPERADMIN_EMAIL=superadmin@newdich.tech

# Optional. Comma-separated superadmin emails (only these can create other admins).
SUPERADMIN_EMAILS=superadmin@newdich.tech

# Optional. Public site URL, used to build the one-time admin setup link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
