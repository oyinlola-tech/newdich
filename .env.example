# The contact endpoint (api/contact.ts). Set these on the host, never in the
# client bundle — a Resend key is a secret and there is no browser-safe
# publishable variant of it.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where enquiries land.
CONTACT_TO=newdichngr@gmail.com

# Optional. Must be a sender on a domain verified in the Resend dashboard.
# Until newdich.tech is verified, Resend's shared onboarding sender is used.
CONTACT_FROM=Newdich site <hello@newdich.tech>
